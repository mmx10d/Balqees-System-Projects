<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../style/allpage.css">
    <link rel="stylesheet" href="../style/other_price_calculator.css">
    <title>إدارة المنتجات
    </title>
</head>
<body>
    <div id="body_price_calculator">
        <div>
            <input type="number" id="price_input" placeholder="0" class="scale_animation">
            <span>السعر</span>
        </div>
        <div>
            <input type="number" id="count_input" placeholder="1" class="scale_animation">
            <span>العدد</span>
        </div>
        <button id="agree" class="scale_animation">موافق</button>
    </div>
    <div id="price_calculator_div" class="info_show" style="display: none;">
        <span>المجموع</span>
        <hr>
        <div>
            <div>
                <span id="price_span">--</span>
                <span>السعر</span>
            </div>
            <div>
                <span id="count_span">--</span>
                <span>العدد</span>
            </div>
            <div>
                <span>المجموع:</span>
            </div>
            <span id="total_span">--</span>
        </div>
        <button id="close_btn">اغلاق</button>
        <button id="earning_btn">الارباح</button>
    </div>
<script src="../script/allpage.js"></script>
<script src="../script/other_price_calculator.js"></script>
</body>
</html>