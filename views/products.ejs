<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../style/allpage.css">
    <link rel="stylesheet" href="../style/products.css">
    <title>إدارة المنتجات
    </title>
</head>
<body>
    <div id="search_div">
        <input type="text" placeholder="بحث" id="search_input">
        <div id="search_btn">
            <img src="../images/icons/search.png">
        </div>
    </div>
    <div class="product_div"></div>
    <div class="add_product_btn scale_animation">+</div>
    <div id="add_product_div" class="info_show" style="display: none;">
        <span>Add Product</span>
        <div>
            <div id="add_photo_div">
                <img src="/images/products/defaulte.png" id="add_photo_photo_img">
                <input type="file" style="display: none;" id="uploade_photo">
            </div>
        </div>
        <div>
            <input type="text" placeholder="name" id="add_product_name_input">
            <span>الاسم</span>
        </div>
        <div>
            <input type="number" placeholder="price"  id="add_product_price_input">
            <span>السعر</span>
        </div>
        <div>
            <input type="date" id="add_product_date_input">
            <span>الانتهاء</span>
        </div>
        <div>
            <input type="text" placeholder="original, small"  id="add_product_description_input">
            <span>الوصف</span>
        </div>
        <div id="add_product_btns">
            <button id="add_product_add_btn">اضافه</button>
            <button id="add_product_cancel_btn">الغاء</button>
        </div>
    </div>
    <div class="product_show_information info_show" style="display: none;">
        <div>
            <div>
                <img src="/images/products/almond.png" id="product_show_information_photo_img">
            </div>
            <span>الصورة</span>
        </div>
        <div>
            <span id="product_show_information_name_span">--</span>
            <span>الاسم</span>
        </div>
        <div>
            <span id="product_show_information_price_span">--</span>
            <span>السعر</span>
        </div>
        <div>
            <span id="product_show_information_expire_span">س-- ش-- ي--</span>
            <span>الانتهاء</span>
        </div>
        <div>
            <span id="product_show_information_description_span">--</span>
            <span>الوصف</span>
        </div>
        <div>
            <button id="product_show_information_close_btn">اغلاق</button>
            <button id="product_show_information_remove_btn">حذف</button>
            <button id="product_show_information_edit_btn">تعديل</button>
        </div>
    </div>
<script src="../script/allpage.js"></script>
<script src="../script/products.js"></script>
</body>
</html>