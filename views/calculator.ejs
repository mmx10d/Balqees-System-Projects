<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BALQEES SYSTEM</title>
    <link rel="stylesheet" href="../style/allpage.css">
    <link rel="stylesheet" href="../style/calculator.css">
</head>
<body>
    <div class="body_calculator">
        <div class="calc_result">
            <span id="calc_show">0</span>
        </div>
        <div class="calc_btns">
            <div id="clear_btn" class="btn_head scale_animation">C</div>
            <div id="neg_pos_btn" class="btn_head scale_animation">&plusmn;</div>
            <div id="percent_btn" class="btn_head scale_animation">%</div>
            <div id="div_btn" class="btn_head scale_animation">&div;</div>
            <div class="btn_num btn_head scale_animation">1</div>
            <div class="btn_num btn_head scale_animation">2</div>
            <div class="btn_num btn_head scale_animation">3</div>
            <div id="mul_btn" class="btn_head scale_animation">	&times;</div>
            <div class="btn_num btn_head scale_animation">4</div>
            <div class="btn_num btn_head scale_animation">5</div>
            <div class="btn_num btn_head scale_animation">6</div>
            <div id="min_btn" class="btn_head">-</div>
            <div class="btn_num btn_head scale_animation">7</div>
            <div class="btn_num btn_head scale_animation">8</div>
            <div class="btn_num btn_head scale_animation">9</div>
            <div id="plus_btn" class="btn_head scale_animation">+</div>
            <div class="btn_num btn_head scale_animation" id="zero_btn">0</div>
            <div class="btn_num btn_head scale_animation">.</div>
            <div id="equal_btn" class="btn_head scale_animation">=</div>
        </div>
    </div>
<script src="../script/allpage.js"></script>
<script src="../script/calculator.js"></script>
</body>
</html>