<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../style/allpage.css">
    <link rel="stylesheet" href="../style/orders.css">
    <title>إدارة المنتجات
    </title>
</head>
<body>
    <button id="add_button" class="scale_animation">+</button>
    <div id="body">
        <div id="order_informations">
            <span id="order_informations_span_name">order</span>
            <span>العدد</span>
            <div></div>
        </div>
        <div id="order_product_div">
            <div class="order_products">
                <span class="order_products_name_span">coffe</span>
                <div>
                    <span>KG</span>
                    <span>5</span>
                </div>
                <button>❌</button>
            </div>
            <div class="order_products">
                <span class="order_products_name_span">coffe</span>
                <div>
                    <span>KG</span>
                    <span>5</span>
                </div>
                <button>❌</button>
            </div>
        </div>
        <div>
            <button id="print_btn" class="scale_animation">طباعة</button>
        </div>
    </div>
    <div class="order_add_div info_show" style="display: none">
        <span>اضافة طلب</span>
        <div>
            <input type="text" placeholder="اسم" id="order_add_name_input">
            <span>الطلب</span>
        </div>
        <div>
            <select id="order_add_select">
                <option value="حبة">كمية</option>
                <option value="وزن">وزن</option>
            </select>
            <input type="number" placeholder="1" id="order_add_count_input">
            <span>عدد</span>
        </div>
        <button id="order_add_add_btn">اضافة</button>
    </div>
<script src="../script/allpage.js"></script>
<script src="../script/orders.js"></script>
</body>
</html>